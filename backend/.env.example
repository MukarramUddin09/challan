# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/ghmc-challan?retryWrites=true&w=majority

# JWT secret key (use a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Gmail SMTP credentials
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Or allow multiple frontend origins (comma-separated)
# FRONTEND_URLS=http://localhost:5173,https://your-frontend.example.com

# Server port
PORT=5000

# Environment
NODE_ENV=development
